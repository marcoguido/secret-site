# IBAN values shown in the Lista Nozze (Gifts) section.
# Copy this file to `.env.local` (gitignored) and fill in the real values.
# These are exposed to the client bundle, so they must be VITE_-prefixed.
VITE_TRAVEL_IBAN=IT00X0000000000000000000000
VITE_TRAVEL_IBAN_HOLDER="Mario Rossi"
VITE_TRAVEL_IBAN_BANK="Banca Esempio"
VITE_GIFT_IBAN=IT00X0000000000000000000000
VITE_GIFT_IBAN_HOLDER="Mario Rossi"
VITE_GIFT_IBAN_BANK="Banca Esempio"
# Google Form the RSVP section proxies submissions to.
# Use the form's "viewform" share URL — the app derives the formResponse endpoint.
VITE_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/FORM_ID/viewform
